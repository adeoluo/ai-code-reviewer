flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces and prompt"]
        direction TB
        Client([HTTP client]):::edge
        CLI(["CLI<br/>review, evaluate, serve"]):::edge
        Router["Router<br/>/review, /evaluate"]:::edge
        Validate["Validation<br/>100,000 char cap"]:::control
        Prompt["Build prompt<br/>rules + diff in tags"]:::core
        CLI ~~~ Client --> Router --> Validate --> Prompt
    end

    subgraph Providers["Provider protocol"]
        direction TB
        Fake["FakeProvider<br/>offline default"]:::core
        Diff["Diff parser<br/>added lines"]:::core
        Rules["Rule detector<br/>eval, shell=True, SQL"]:::control
        Claude[["AnthropicProvider<br/>Claude Messages API"]]:::edge
        Fake --> Diff --> Rules ~~~ Claude
    end

    subgraph Output["Output and evaluation"]
        direction TB
        Parse["Parse JSON comments<br/>drop malformed items"]:::control
        Result["Review<br/>path, line, severity"]:::core
        Cases[("Labeled benchmark<br/>buggy and clean diffs")]:::data
        Report["BugReport<br/>precision, recall, F1"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Parse --> Result --> Report
        Cases --> Report
        Report ~~~ Metrics
    end

    Interfaces -->|system + prompt| Providers
    Providers -->|JSON comments| Output
